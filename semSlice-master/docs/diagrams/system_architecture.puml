@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #444444
skinparam ArrowThickness 1
skinparam rectangle {
  BorderColor #4A4A4A
  FontColor #222222
  BackgroundColor #EEEEEE
}

top to bottom direction

rectangle "系统架构（语义切片资源管理平台）" as SYS #E8E8E8 {
  rectangle "L0 角色与权限层\n管理员入口（Admin） | 租户入口（Tenant）" as B1

  rectangle "L1 交互与可视化层\n控制台界面 | 配置管理 | 可视化组件 | 数据反馈展示 | 策略对比" as B2

  rectangle "L2 网关与流程编排层\nRESTful API 网关（FastAPI）\n认证与权限管理 | 租户隔离过滤 | 系统级流程编排（admin/tenant run）" as B3

  rectangle "L3 服务算法与数据支撑层\n语义通信处理 | 切片构建与分发 | 切片与业务适配 | 资源管理与编排 | 性能评估\nLegacy仿真实验适配 | 运行状态缓存 | 结果数据存储" as B4
}

B1 --> B2
B2 --> B3
B3 --> B4
@enduml
