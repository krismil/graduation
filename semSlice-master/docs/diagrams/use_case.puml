@startuml
left to right direction

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam ArrowColor #4A4A4A
skinparam ArrowThickness 1

skinparam actor {
  BorderColor #2F5D8A
  FontColor #1F2D3D
}

skinparam usecase {
  BorderColor #4A5D73
  BackgroundColor #EEF3F8
  FontColor #1F2D3D
}

actor "管理员" as Admin
actor "租户用户" as Tenant

rectangle "语义通信切片系统（精简版）" as SYS #F5F5F5 {
  package "一级用例（总览）" as L1 #F8FBFF {
    usecase "认证与权限模块" as UC1
    usecase "语义通信模块" as UC2
    usecase "切片构建与分发模块" as UC3
    usecase "切片与业务适配模块" as UC4
    usecase "资源管理与编排模块" as UC5
    usecase "性能评估与分析模块" as UC6
  }

  package "切片与业务适配" as F1 #F8FBFF {
    usecase "A1 业务画像构建" as A1
    usecase "A2 匹配评分计算" as A2
    usecase "A3 最优切片输出" as A3
    A3 .> A1 : <<include>>
    A3 .> A2 : <<include>>
  }

  package "资源管理与编排" as F2 #F8FBFF {
    usecase "B1 分配算法选择" as B1
    usecase "B2 用户级资源分配" as B2
    usecase "B3 约束校验与修正" as B3
    B2 .> B1 : <<include>>
    B2 .> B3 : <<include>>
  }
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6

Tenant --> UC1
Tenant --> UC2
Tenant --> UC4
Tenant --> UC5
Tenant --> UC6

UC4 .> UC2 : <<include>>
UC5 .> UC4 : <<include>>
UC6 .> UC5 : <<include>>

UC4 .> A3 : <<refine>>
UC5 .> B2 : <<refine>>
@enduml
